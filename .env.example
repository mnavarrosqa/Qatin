# Server Configuration
PORT=8545
NODE_ENV=production

# Jira Configuration (optional fallback — prefer Settings → Jira in the UI)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token

# LLM Configuration (OpenAI | DeepSeek | Claude | openai-compatible | ollama)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview
LLM_BASE_URL=
LLM_API_KEY=

# Ollama (local or remote server). Example remote: http://192.168.1.10:11434/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# Provider API keys
OPENAI_API_KEY=sk-your-openai-key
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional: encrypt project credentials at rest
CREDENTIALS_SECRET=

# SQLite database path
SQLITE_PATH=./data/qatin.db

# Redis Configuration (for job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Playwright Configuration
HEADLESS=true
BROWSER_TIMEOUT=30000
SCREENSHOTS_DIR=./screenshots
MAX_CONCURRENT_TESTS=3

# Application URLs to test (defaults; overridden per project in UI)
APP_BASE_URL=https://your-app.com
APP_STAGING_URL=https://staging.your-app.com

# Authentication (if needed for your app)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=test-password

# Logging
LOG_LEVEL=info
