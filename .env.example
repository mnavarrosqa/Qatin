# Server
PORT=8545
NODE_ENV=production

# Absolute install root (optional). deploy.sh / PM2 set this automatically.
# APP_ROOT=/opt/qatin

# Jira (optional fallback — prefer Settings → Jira in the UI)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token

# LLM (OpenAI | DeepSeek | Claude | openai-compatible | ollama)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview
LLM_BASE_URL=
LLM_API_KEY=

# Ollama (local or remote). Example: http://192.168.1.10:11434/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

OPENAI_API_KEY=sk-your-openai-key
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Required in production: encrypts project test passwords at rest in SQLite.
# deploy.sh generates one if empty. Do not leave blank on a shared server.
CREDENTIALS_SECRET=

# Paths (relative paths resolve against APP_ROOT)
SQLITE_PATH=./data/qatin.db
SCREENSHOTS_DIR=./screenshots

# Redis (job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Playwright
HEADLESS=true
BROWSER_TIMEOUT=30000
MAX_CONCURRENT_TESTS=3

# App under test (defaults; overridden per project in UI)
APP_BASE_URL=https://your-app.com
APP_STAGING_URL=https://staging.your-app.com
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=test-password

LOG_LEVEL=info
