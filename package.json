{
  "name": "jira-qa-agent",
  "version": "1.1.0",
  "description": "Automated QA agent that tests Jira tickets using Playwright",
  "main": "dist/server.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/postinstall-hint.mjs",
    "build": "npm run build:mcp && npm run build:server && npm run build:web",
    "build:mcp": "npm install --prefix mcp-server-jira && npm run build --prefix mcp-server-jira",
    "build:server": "tsc",
    "build:web": "npm run build --prefix web",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:web": "npm run dev --prefix web",
    "dev:worker": "tsx watch src/worker.ts",
    "test": "jest",
    "worker": "node dist/worker.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 startOrReload ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "redeploy": "bash scripts/redeploy.sh",
    "preflight": "bash scripts/pre-deploy-check.sh"
  },
  "keywords": [
    "jira",
    "qa",
    "automation",
    "playwright",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.6.2",
    "better-sqlite3": "^13.0.3",
    "bull": "^4.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "ioredis": "^5.3.2",
    "openai": "^4.20.0",
    "playwright": "^1.40.0",
    "pm2": "^6.0.14",
    "sharp": "^0.33.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/bull": "^4.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2"
  }
}
